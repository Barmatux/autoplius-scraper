# Test mode: save snapshots locally, no upstream sync
TEST_MODE=true

# First N pages of all used-car listings (no make filter)
SCRAPE_PAGES=10
PAGE_DELAY_SEC=3
SCRAPE_INTERVAL_HOURS=1
SCRAPE_TIMEOUT_SEC=180

# Detail enrichment (full listing pages)
ENRICH_DETAILS=true
# 0 = all listings from search pages (~200 for 10 pages)
ENRICH_LIMIT=0
DETAIL_DELAY_SEC=2

# SQLite (default: $DATA_DIR/autoplius.db)
# DB_PATH=/var/lib/autoplius-scraper/data/autoplius.db

# Browser / captcha
AUTO_CAPTCHA=true
HEADLESS=true
CAPTCHA_2CAPTCHA_API_KEY=

# Optional UI basic auth
# UI_USER=
# UI_PASSWORD=

# Belarus buyer price in USD (EUR→USD via myfin.by best buy rate; refresh every 30 min)
# PRICE_RB_EUR_USD=1.158
# PRICE_RB_LANDED_FACTOR=1.0
# PRICE_RB_EXTRA_USD=0

# Paths (defaults are fine for local/VM)
# DATA_DIR=data
# PROFILE_DIR=.browser-profile
# LOGS_DIR=logs

# Autoplius source language (Russian UI)
AUTOPLIUS_BASE_URL=https://ru.autoplius.lt
# Translate seller descriptions to Russian during scrape
TRANSLATE_DESCRIPTIONS=true
# TRANSLATE_DELAY_SEC=0.5

# MinIO / S3 (same scheme as auto160)
# Sync listing photos to MinIO right after each scrape run (current run only)
SYNC_PHOTOS_AFTER_SCRAPE=true
# SYNC_PHOTOS_TIMEOUT_SEC=25
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=autoplius-media
# S3_REGION=us-east-1
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=change-me-minio-password
