# Test mode: save snapshots locally, no upstream sync
TEST_MODE=true

# First N pages of all used-car listings (no make filter)
SCRAPE_PAGES=10
PAGE_DELAY_SEC=3
SCRAPE_INTERVAL_HOURS=1
SCRAPE_TIMEOUT_SEC=180

# Incremental runs (default): newest-first search, stop when pages have no new IDs vs DB.
# Full refresh (all SCRAPE_PAGES + enrich all) runs every FULL_SCRAPE_INTERVAL_HOURS.
INCREMENTAL_SCRAPE=true
INCREMENTAL_STOP_EMPTY_PAGES=2
ENRICH_NEW_ONLY=true
SEARCH_NEWEST_FIRST=true
FULL_SCRAPE_INTERVAL_HOURS=12
# Mark listings missing from a full scrape snapshot as archived (av.by-style)
ARCHIVE_REMOVED_ON_FULL_SCRAPE=true

# Detail enrichment (full listing pages)
ENRICH_DETAILS=true
# 0 = all listings from search pages (~200 for 10 pages)
ENRICH_LIMIT=0
DETAIL_DELAY_SEC=2
# Target batch / resume (slower = fewer Autoplius rate-limit blocks)
# TARGET_DETAIL_DELAY_SEC=10
# TARGET_PAGE_DELAY_SEC=6

# SQLite (default: $DATA_DIR/autoplius.db)
# DB_PATH=/var/lib/autoplius-scraper/data/autoplius.db

# Browser / captcha
AUTO_CAPTCHA=true
HEADLESS=true
CAPTCHA_2CAPTCHA_API_KEY=

# Optional UI basic auth (legacy; admin uses ADMIN_* below)
# UI_USER=
# UI_PASSWORD=

# Admin panel basic auth (/admin/*). Falls back to UI_USER/UI_PASSWORD when unset.
# ADMIN_USER=
# ADMIN_PASSWORD=

# Belarus buyer price (myfin best buy rates; auto-refreshed every 30 min via GitHub Actions)
# Manual override only if needed:
# PRICE_RB_EUR_USD=1.158
# PRICE_RB_USD_BYN=3.04

# Paths (defaults are fine for local/VM)
# DATA_DIR=data
# PROFILE_DIR=.browser-profile
# LOGS_DIR=logs

# Autoplius source language (Russian UI)
AUTOPLIUS_BASE_URL=https://ru.autoplius.lt
# Translate seller descriptions to Russian during scrape
TRANSLATE_DESCRIPTIONS=true
# TRANSLATE_DELAY_SEC=0.5

# MinIO / S3 (same scheme as auto160)
# Sync listing photos to MinIO right after each scrape run (current run only)
SYNC_PHOTOS_AFTER_SCRAPE=true
# SYNC_PHOTOS_TIMEOUT_SEC=45
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=autoplius-media
# S3_REGION=us-east-1
# Resized photo cache (VM-local, for Russian clients that cannot reach autoplius CDN)
# MEDIA_CACHE_DIR=/var/lib/autoplius-scraper/media-cache
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=change-me-minio-password
