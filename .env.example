# Test mode: save snapshots locally, no upstream sync
TEST_MODE=true

# First N pages of all used-car listings (no make filter)
SCRAPE_PAGES=10
PAGE_DELAY_SEC=3
SCRAPE_INTERVAL_HOURS=1
SCRAPE_TIMEOUT_SEC=180

# Detail enrichment (full listing pages)
ENRICH_DETAILS=true
# 0 = all listings from search pages (~200 for 10 pages)
ENRICH_LIMIT=0
DETAIL_DELAY_SEC=2

# SQLite (default: $DATA_DIR/autoplius.db)
# DB_PATH=/var/lib/autoplius-scraper/data/autoplius.db

# Browser / captcha
AUTO_CAPTCHA=true
HEADLESS=true
CAPTCHA_2CAPTCHA_API_KEY=

# Optional UI basic auth
# UI_USER=
# UI_PASSWORD=

# Paths (defaults are fine for local/VM)
# DATA_DIR=data
# PROFILE_DIR=.browser-profile
# LOGS_DIR=logs
