# Test mode: save snapshots locally, no upstream sync
TEST_MODE=true

# First N pages of all used-car listings (no make filter)
SCRAPE_PAGES=10
PAGE_DELAY_SEC=3
SCRAPE_INTERVAL_HOURS=1
SCRAPE_TIMEOUT_SEC=180

# Incremental runs (default): newest-first search, stop when pages have no new IDs vs DB.
# Full refresh (all SCRAPE_PAGES + enrich all) runs every FULL_SCRAPE_INTERVAL_HOURS.
INCREMENTAL_SCRAPE=true
INCREMENTAL_STOP_EMPTY_PAGES=2
ENRICH_NEW_ONLY=true
SEARCH_NEWEST_FIRST=true
FULL_SCRAPE_INTERVAL_HOURS=12
# Mark listings missing from a full scrape snapshot as archived (av.by-style)
ARCHIVE_REMOVED_ON_FULL_SCRAPE=true

# Nightly reconcile (02:30 Europe/Minsk): A deep search + B live probe
# NIGHTLY_DEEP_SEARCH=true
# NIGHTLY_LIVE_PROBE=true
# NIGHTLY_MAX_PAGES=500
# NIGHTLY_PAGE_DELAY_SEC=4
# NIGHTLY_ENRICH_DETAILS=false
# NIGHTLY_ARCHIVE_MIN_PAGES=20
# NIGHTLY_ARCHIVE_MIN_LISTINGS=500
# NIGHTLY_ARCHIVE_MAX=3000
# NIGHTLY_STALE_HOURS=36
# NIGHTLY_PROBE_LIMIT=250
# NIGHTLY_PROBE_DELAY_SEC=2.5
# NIGHTLY_PROBE_MAX_UNKNOWN_STREAK=25

# Detail enrichment (full listing pages)
ENRICH_DETAILS=true
# 0 = all listings from search pages (~200 for 10 pages)
ENRICH_LIMIT=0
DETAIL_DELAY_SEC=2
# Target batch / resume (slower = fewer Autoplius rate-limit blocks)
# TARGET_DETAIL_DELAY_SEC=10
# TARGET_PAGE_DELAY_SEC=6

# SQLite (default: $DATA_DIR/autoplius.db)
# DB_PATH=/var/lib/autoplius-scraper/data/autoplius.db

# Browser / captcha
AUTO_CAPTCHA=true
HEADLESS=true
CAPTCHA_2CAPTCHA_API_KEY=

# Optional UI basic auth (legacy; admin uses ADMIN_* below)
# UI_USER=
# UI_PASSWORD=

# Admin panel basic auth (/admin/*). Falls back to UI_USER/UI_PASSWORD when unset.
# ADMIN_USER=
# ADMIN_PASSWORD=

# Contract staff (login:password, comma-separated). Access only /admin/contracts.
# If unset, built-in accounts are used: dir_max, manager_alex, roman1067.
# CONTRACT_USERS=dir_max:77997799,manager_alex:77997799,roman1067:10671067

# Flask session signing key (required for login/cabinet sessions in production).
# FLASK_SECRET_KEY=

# Personal cabinet users are stored in SQLite (users table).
# Create the first user on the VM:
#   DATA_DIR=/var/lib/autoplius-scraper/data python3 tools/create_user.py USERNAME PASSWORD

# Belarus buyer price (myfin best buy rates; stored in SQLite exchange_rates, refreshed every 30 min via GitHub Actions)
# Manual override only if needed:
# PRICE_RB_EUR_USD=1.158
# PRICE_RB_USD_BYN=3.04

# Paths (defaults are fine for local/VM)
# DATA_DIR=data
# PROFILE_DIR=.browser-profile
# LOGS_DIR=logs

# Autoplius source language (Russian UI)
AUTOPLIUS_BASE_URL=https://ru.autoplius.lt
# Translate seller descriptions to Russian during scrape
TRANSLATE_DESCRIPTIONS=true
# TRANSLATE_DELAY_SEC=0.5

# Public site URL for sitemap/robots (no trailing slash)
# PUBLIC_SITE_URL=https://eu2.by

# auto160 catalog match (optional; after scrape ↔ INTERNAL_CATALOG_API_KEY on auto160)
# AUTO160_CATALOG_BASE_URL=http://127.0.0.1:8000
# AUTO160_CATALOG_API_KEY=

# Feedback modal: messenger deep links (open chat after click)
# FEEDBACK_TELEGRAM_URL=https://t.me/your_username
# FEEDBACK_WHATSAPP_URL=https://wa.me/375291112233
# or build WhatsApp from phone digits:
# FEEDBACK_WHATSAPP_PHONE=375291112233
# FEEDBACK_VIBER_URL=viber://chat?number=%2B375291112233

# Legal entity (defaults = ООО «Сканди Моторс» from XL contract; override via env)
# COMPANY_FULL_NAME=Общество с ограниченной ответственностью «Сканди Моторс»
# COMPANY_SHORT_NAME=ООО «Сканди Моторс»
# COMPANY_UNP=193866357
# COMPANY_LEGAL_ADDRESS=г. Минск, ул. Скрыганова, дом 6, помещение 7
# COMPANY_POSTAL_ADDRESS=г. Минск, ул. Скрыганова, дом 6, помещение 7
# COMPANY_REG_AUTHORITY=
# COMPANY_REG_DATE=
# COMPANY_REG_NUMBER=
# COMPANY_DIRECTOR=Герасимец Максим Сергеевич
# COMPANY_DIRECTOR_GENITIVE=Герасимца Максима Сергеевича
# COMPANY_DIRECTOR_SHORT=Герасимец М.С.
# COMPANY_EMAIL=scandimotorsby@gmail.com
# COMPANY_PHONE=+375 (33) 698-77-99
# COMPANY_WORK_HOURS=Пн–Пт 10:00–19:00 (время Минска)
# COMPANY_BANK_NAME=ЗАО «Альфа-Банк», 220013, г. Минск, ул. Сурганова, 43-47
# COMPANY_BANK_BIC=ALFABY2X
# COMPANY_BANK_ACCOUNT=BY58 ALFA 3012 2G91 3900 1027 0000
# COMPANY_BANK_SWIFT=ALFABY2X
# COMPANY_BANK_UNP=101541947
# COMPANY_OKPO=37526626
# COMPANY_TRADE_REGISTER_DATE=
# COMPANY_SUPPORT_TELEGRAM=

SYNC_PHOTOS_AFTER_SCRAPE=true
# SYNC_PHOTOS_TIMEOUT_SEC=45
# S3_ENDPOINT_URL=https://storage.yandexcloud.net
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=autoplius-media
# S3_REGION=ru-central1
# Resized photo cache (VM-local, for Russian clients that cannot reach autoplius CDN)
# MEDIA_CACHE_DIR=/var/lib/autoplius-scraper/media-cache
# Deprecated local MinIO (do not use on new deploys):
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=change-me-minio-password
