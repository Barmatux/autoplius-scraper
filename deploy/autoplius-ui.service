[Unit]
Description=Autoplius scraper results UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/autoplius-scraper
EnvironmentFile=-/opt/autoplius-scraper/.env
Environment=DATA_DIR=/var/lib/autoplius-scraper/data
Environment=PROFILE_DIR=/var/lib/autoplius-scraper/browser-profile
Environment=LOGS_DIR=/var/log/autoplius-scraper
Environment=LISTING_LIVE_BROWSER=1
Environment=UI_HOST=0.0.0.0
Environment=UI_PORT=8080
Environment=UI_HOME_CACHE_TTL_SEC=90
Environment=UI_HOME_CACHE_BOT_TTL_SEC=180
# gevent: concurrent /media/object S3 reads without blocking HTML pages.
# 2 workers: YandexBot + users share load on a small VM.
ExecStart=/opt/autoplius-scraper/.venv/bin/gunicorn \
    --bind 0.0.0.0:8080 \
    --workers 2 \
    --worker-class gevent \
    --worker-connections 128 \
    --timeout 120 \
    --access-logfile /var/log/autoplius-scraper/gunicorn-access.log \
    --error-logfile /var/log/autoplius-scraper/gunicorn-error.log \
    --access-logformat '%%(h)s %%(t)s "%%(r)s" %%(s)s %%(b)s %%(D)sus %%(L)ss "%%(a)s"' \
    ui.app:app
User=autoplius
Group=autoplius
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
