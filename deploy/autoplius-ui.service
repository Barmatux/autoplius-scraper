[Unit]
Description=Autoplius scraper results UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/autoplius-scraper
EnvironmentFile=-/opt/autoplius-scraper/.env
Environment=DATA_DIR=/var/lib/autoplius-scraper/data
Environment=UI_HOST=127.0.0.1
Environment=UI_PORT=8081
# gevent: many concurrent /media/object S3 reads without blocking HTML pages.
ExecStart=/opt/autoplius-scraper/.venv/bin/gunicorn \
    --bind 127.0.0.1:8081 \
    --workers 1 \
    --worker-class gevent \
    --worker-connections 256 \
    --timeout 120 \
    --access-logfile - \
    ui.app:app
User=autoplius
Group=autoplius
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
