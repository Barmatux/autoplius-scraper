[Unit]
Description=Autoplius scraper results UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/autoplius-scraper
EnvironmentFile=-/opt/autoplius-scraper/.env
Environment=DATA_DIR=/var/lib/autoplius-scraper/data
Environment=UI_HOST=0.0.0.0
Environment=UI_PORT=8080
# gthread: one worker avoids SQLite write races; threads handle concurrent /media/* S3 I/O.
ExecStart=/opt/autoplius-scraper/.venv/bin/gunicorn \
    --bind 0.0.0.0:8080 \
    --workers 1 \
    --worker-class gthread \
    --threads 16 \
    --timeout 120 \
    --access-logfile - \
    ui.app:app
User=autoplius
Group=autoplius
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
